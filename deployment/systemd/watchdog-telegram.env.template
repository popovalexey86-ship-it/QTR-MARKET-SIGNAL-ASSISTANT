# Install as /etc/qtr/watchdog-telegram.env with mode 0600, owned by root.
# Use a distinct Watchdog bot. Never commit the filled-in file.
QTR_WATCHDOG_TELEGRAM_BOT_TOKEN=REPLACE_WITH_PRIVATE_TOKEN
QTR_WATCHDOG_TELEGRAM_CHAT_ID=REPLACE_WITH_ALLOWED_CHAT_ID
# Required only when the optional control panel is enabled.
# This is the Telegram numeric user ID, separate from the chat ID.
QTR_WATCHDOG_TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_ALLOWED_USER_ID
