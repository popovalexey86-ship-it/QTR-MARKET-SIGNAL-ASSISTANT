[Unit]
Description=QTR Market Watchdog Phase 5 isolated shadow soak
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/opt/qtr/watchdog-shadow
ConditionPathIsDirectory=/opt/qtr/watchdog-shadow-data/phase5-soak

[Service]
Type=simple
User=qtr
Group=qtr
WorkingDirectory=/opt/qtr/watchdog-shadow
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/qtr/watchdog-shadow/.venv/bin/python -m market_signal_assistant.watchdog.runtime.soak --data-root /opt/qtr/watchdog-shadow-data/phase5-soak --duration-hours 24 --symbols-per-loop 8 --api-calls-per-minute 60
Restart=on-failure
RestartSec=15s
TimeoutStopSec=75s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qtr/watchdog-shadow-data/phase5-soak
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
