[Unit]
Description=QTR Micro Scalper V2 Shadow Observer
Documentation=file:/opt/qtr/scalper-shadow/deployment/QTR_SCALPER_SHADOW_INSTALL.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/qtr/scalper-shadow/.venv/bin/python
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=qtr
Group=qtr
WorkingDirectory=/opt/qtr/scalper-shadow

# Fail-closed defaults: no market stream until an explicit operator override.
Environment=PYTHONUNBUFFERED=1
Environment=QTR_SCALPER_V2_ENABLED=false
Environment=QTR_SCALPER_V2_SHADOW_MODE=true
Environment=QTR_SCALPER_V2_LIVE_ENABLED=false
Environment=QTR_SCALPER_V2_SETUP_AUDIT_PATH=/opt/qtr/scanner/data/qtr_setup_telegram_pilot_audit.jsonl

ExecStart=/opt/qtr/scalper-shadow/.venv/bin/python -m market_signal_assistant.qtr_micro_scalper.cli --refresh-seconds 30
Environment=QTR_SCALPER_V2_DYNAMIC_TARGETS_ENABLED=false
Environment=QTR_SCALPER_V2_MAX_ACTIVE_SYMBOLS=5
Environment=QTR_SCALPER_V2_TARGET_REFRESH_SECONDS=30
Environment=QTR_SCALPER_V2_HOLDING_EXPERIMENT_ENABLED=false
Environment=QTR_SCALPER_V2_HOLDING_EXPERIMENT_MAX_ACTIVE_GROUPS=1000
Environment=QTR_SCALPER_V2_HOLDING_EXPERIMENT_JOURNAL_PATH=/opt/qtr/scalper-shadow/data/qtr_micro_scalper_holding_experiment.jsonl
Environment=QTR_SCALPER_V2_MICRO_PROFIT_EXPERIMENT_ENABLED=false
Environment=QTR_SCALPER_V2_MICRO_PROFIT_MAX_ACTIVE_GROUPS=1000
Environment=QTR_SCALPER_V2_MICRO_PROFIT_EXPERIMENT_JOURNAL_PATH=/opt/qtr/scalper-shadow/data/qtr_micro_scalper_micro_profit_experiment.jsonl
Environment=QTR_SCALPER_V2_COST_MODEL_ENABLED=true
Environment=QTR_SCALPER_V2_COST_SCENARIO=taker_taker
Environment=QTR_SCALPER_V2_COST_TAKER_FEE_RATE=0.00055
Environment=QTR_SCALPER_V2_COST_MAKER_FEE_RATE=0.00020
Environment=QTR_SCALPER_V2_COST_SLIPPAGE_BPS=0
Environment=QTR_SCALPER_V2_COST_FUNDING_RATE_8H=0
Environment=QTR_SCALPER_V2_RUNNER_TRAILING_R=0.10
Environment=QTR_SCALPER_V2_RUNNER_MAXIMUM_SAFETY_BARS=300

Restart=on-failure
RestartSec=10s

KillSignal=SIGTERM
TimeoutStopSec=30s
SendSIGKILL=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qtr-scanner-scalper-shadow

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=-/opt/qtr/scanner/data/qtr_setup_telegram_pilot_audit.jsonl
ReadWritePaths=/opt/qtr/scalper-shadow/data

# Intentionally no install section: installation does not enable autostart.
